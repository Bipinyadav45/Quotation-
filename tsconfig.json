{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "shared",
    "server/src",
    // The scripts are real TypeScript that imports the real modules, and they
    // were outside this list: render-preview.ts broke on a schema change that
    // `tsc --noEmit` structurally could not see, and stayed broken until
    // somebody happened to run it.
    "server/scripts",
    "web/src",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
