# Copy to .env and fill in. .env is gitignored — never commit it.

# Server-side only. This key must never reach the browser bundle;
# there is a test that greps web/dist to prove it.
ANTHROPIC_API_KEY=

PORT=4000
DB_PATH=./data/quotes.db
TEMPLATE_PATH=./server/templates/quotation-template.docx

# Absolute path to the LibreOffice binary used for DOCX -> PDF conversion.
# Leave blank to auto-detect the usual install locations.
#
# LibreOffice is NOT currently installed on this machine. Until it is, the
# .docx download works normally and the PDF endpoint returns a clear 503.
# To install:  winget install --id TheDocumentFoundation.LibreOffice
#
# Windows default: C:\Program Files\LibreOffice\program\soffice.exe
# macOS default:   /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=

# Everything sent from this domain is ours, so a priced line in a block from
# any other domain gets surfaced for manual role reassignment (§5).
INTERNAL_EMAIL_DOMAIN=newtech.in
