# Copy to .env and fill in. .env is gitignored — never commit it.

# Google AI Studio key for the three AI features. Server-side only: it must
# never reach the browser bundle, and web/bundle-safety.test.ts greps the built
# output for this actual value to prove it does not.
#
# Optional. Without it the application is fully usable — the customer master,
# price memory, the parser and every document path work unchanged; the AI
# features simply are not offered. See /api/capabilities.
GEMINI_API_KEY=

# LEAVE BLANK unless you have a reason. server/src/lib/ai.ts picks the model and
# holds the fallback chain, and its default is the one currently answering.
#
# This line used to read GEMINI_MODEL=gemini-3.7-flash, copied from a working
# setup. ai.ts explicitly deprioritised that model because it stopped answering
# and hung for ~200 seconds before giving up — so anyone copying this file
# verbatim was reintroducing a known outage on their first day.
GEMINI_MODEL=

# The API port. Express serves the API and, in production, the built frontend
# from this one port.
PORT=4000

# The dev-server port. Vite reads it from this same file, and proxies /api to
# PORT above — the two used to be named independently and drifted apart, which
# left every /api call going nowhere. Development only; unused in production.
WEB_PORT=5173

DB_PATH=./data/quotes.db
TEMPLATE_PATH=./server/templates/quotation-template.docx

# Absolute path to the LibreOffice binary used for DOCX -> PDF conversion.
# Leave blank to auto-detect the usual install locations.
#
# LibreOffice is NOT currently installed on this machine. Until it is, the
# .docx download works normally and the PDF endpoint returns a clear 503.
# To install:  winget install --id TheDocumentFoundation.LibreOffice
#
# Windows default: C:\Program Files\LibreOffice\program\soffice.exe
# macOS default:   /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=

# Everything sent from this domain is ours, so a priced line in a block from
# any other domain gets surfaced for manual role reassignment (§5).
INTERNAL_EMAIL_DOMAIN=newtech.in

# Which converter turns the .docx into a PDF. Leave blank to auto-detect:
# LibreOffice is preferred when present (headless, works on a server, does not
# tie up the user's Word); Microsoft Word is used otherwise and needs no
# administrator rights to install.
#   PDF_BACKEND=libreoffice | word
#
# Blank is right for local development — take whichever converter you have.
#
# QA and production do NOT auto-detect: the Dockerfile pins
# PDF_BACKEND=libreoffice, because the Word path drives Office over COM, which
# Microsoft advise against on a server and which once left 282 orphaned
# WINWORD.EXE processes filling a disk with 12.7 GB of telemetry. If you set
# this to `word` locally, remember QA is testing the other backend.
PDF_BACKEND=

# Only needed if Word is installed somewhere unusual.
# Windows default: C:\Program Files\Microsoft Office\root\Office16\WINWORD.EXE
WINWORD_PATH=
